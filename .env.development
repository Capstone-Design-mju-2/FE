# 팀 공통 개발 기본값. 내 컴퓨터에서만 바꾸려면 .env.development.local을 만든다 (git에 안 올라감).

# true면 BE 없이 src/mocks/chat-response.example.json으로 응답한다.
VITE_USE_MOCK=true

# /api 요청을 넘길 agent-service 주소 (BE .env.example의 AGENT_SERVICE_PORT와 맞춘다)
AGENT_SERVICE_URL=http://127.0.0.1:8000

# /api/v1/products(상품 목록·리뷰)를 넘길 catalog-service 주소 (BE CATALOG_SERVICE_PORT)
CATALOG_SERVICE_URL=http://127.0.0.1:8081

# /api/v1/orders(주문 생성)를 넘길 order-service 주소 (BE ORDER_SERVICE_PORT)
ORDER_SERVICE_URL=http://127.0.0.1:8082
